# Server-only upstream; browsers always call /api on the Next.js origin.
API_BASE_URL=http://localhost:3000/api
# Public legal identity, rendered on the server; never put CPF here.
LEGAL_CONTROLLER_NAME=
PRIVACY_EMAIL=
# Names of actual hosting, database and backup providers.
LEGAL_SERVICE_PROVIDERS=
# Actual countries/regions and international-transfer arrangements.
LEGAL_DATA_LOCATION=
# Must match the backup policy implemented by the operator.
LEGAL_BACKUP_RETENTION_DAYS=
